# Public Auth0 values (not secrets). Also stored in app.json extra.
EXPO_PUBLIC_AUTH0_DOMAIN=demo-showcase.us.auth0.com  # pragma: allowlist secret
EXPO_PUBLIC_AUTH0_CLIENT_ID=mw7slVl0xn16xgjCLPEN9D3eYk9FqVA5
EXPO_PUBLIC_AUTH0_AUDIENCE=https://expo-pipeline-lab.api
EXPO_PUBLIC_AUTH0_SCHEME=expopipelinelab

# After `eas deploy`, set this to the EAS Hosting origin (no trailing slash)
# so a production iOS build can reach /api/describe.
# Example: https://expo-pipeline-lab.expo.app
EXPO_PUBLIC_API_ORIGIN=

# Server-only. Used by src/app/api/* on EAS Hosting and `npx expo serve`.
# Never prefix AI_GATEWAY_API_KEY with EXPO_PUBLIC_.
AUTH0_DOMAIN=demo-showcase.us.auth0.com  # pragma: allowlist secret
AUTH0_AUDIENCE=https://expo-pipeline-lab.api
AUTH0_ISSUER=https://demo-showcase.us.auth0.com/  # pragma: allowlist secret
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-2.5-flash
